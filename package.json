{
  "workspaces": [
    "packages/biome",
    "packages/bun",
    "packages/core",
    "packages/esbuild",
    "packages/node",
    "packages/tsc",
    "integration"
  ],
  "scripts": {
    "setup": "npm ci && npm ci --prefix configure",
    "configure": "node --experimental-strip-types configure/ninjutsu.mts",
    "build": "ninja",
    "docs": "cd configure && npx typedoc --sortEntryPoints false",
    "format": "npx @biomejs/biome format --write ."
  }
}
